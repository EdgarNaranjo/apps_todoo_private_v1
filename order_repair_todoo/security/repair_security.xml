<odoo>
    <data noupdate="1">
        <!-- Privilege para agrupar los grupos de Repair en Settings > Users & Companies -->
        <record model="res.groups.privilege" id="res_groups_privilege_repair">
            <field name="name">Order Repair</field>
            <field name="sequence">60</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <record id="group_repair_user" model="res.groups">
            <field name="name">Repair User</field>
            <field name="privilege_id" ref="res_groups_privilege_repair"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_repair_admin" model="res.groups">
            <field name="name">Repair Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_repair"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('order_repair_todoo.group_repair_user'))]"/>
        </record>
    </data>
</odoo>
