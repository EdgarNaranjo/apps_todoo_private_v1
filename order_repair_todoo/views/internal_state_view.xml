<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_internal_state_tree" model="ir.ui.view">
        <field name="name">internal.state.tree</field>
        <field name="model">internal.state</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="view_internal_state_form" model="ir.ui.view">
        <field name="name">internal.state.form</field>
        <field name="model">internal.state</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_internal_state_search" model="ir.ui.view">
        <field name="name">internal.state.search</field>
        <field name="model">internal.state</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="parent_id"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="action_internal_state" model="ir.actions.act_window">
        <field name="name">Internal state</field>
        <field name="res_model">internal.state</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new internal state
          </p>
        </field>
    </record>

    <menuitem id="menu_repair_order_internal_state" name="Internal state" parent="menu_setting_repair"
              action="action_internal_state" sequence="4"/>
</odoo>
