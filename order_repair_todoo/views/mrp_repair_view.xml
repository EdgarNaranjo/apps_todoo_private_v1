    <record id="action_stock_picking_wizard" model="ir.actions.act_window">
        <field name="name">Generate stock picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="order_repair_todoo.model_repair_order"/>
        <field name="target">new</field>
    </record>

    <record id="action_repair_order_wizard" model="ir.actions.act_window">
        <field name="name">Do you want to create a new repair order?</field>
        <field name="res_model">repair.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_setting_repair" name="Setting repair" parent="repair.repair_menu_config" sequence="2"
              groups="order_repair_todoo.group_repair_admin"/>
    <menuitem id="menu_setting_vehicle" name="Setting vehicle" parent="repair.repair_menu_config" sequence="3"
              groups="order_repair_todoo.group_repair_admin"/>
</odoo>
