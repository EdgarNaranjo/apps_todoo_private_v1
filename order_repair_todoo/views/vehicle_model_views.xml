<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View vehicle.model View Tree -->
    <record id="view_vehicle_model_tree" model="ir.ui.view">
        <field name="name">view.vehicle.model.tree</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" />
                <field name="vehicle_brand_id" optional="show" />
                <field name="vehicle_fuel_id" optional="show" />
                <field name="vehicle_type_id" optional="show" />
                <field name="create_uid" />
                <field name="create_date" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <!-- View vehicle.model form -->
    <record id="view_vehicle_model_form" model="ir.ui.view">
        <field name="name">view.vehicle.model.form</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Name..." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field
                                name="vehicle_brand_id"
                                options="{'no_create': True}"
                            />
                            <field name="vehicle_fuel_id" options="{'no_create': True}"/>
                            <field name="vehicle_type_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View vehicle.model search -->
    <record id="view_vehicle_model_search" model="ir.ui.view">
        <field name="name">view.vehicle.model.search</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="vehicle_brand_id" />
                <group>
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action vehicle.model -->
    <record id="action_vehicle_model" model="ir.actions.act_window">
        <field name="name">Vehicle Model</field>
        <field name="res_model">vehicle.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Vehicle Model.
            </p>
        </field>
    </record>

    <menuitem id="menu_repair_order_vehicle_model" name="Vehicle Model" parent="menu_setting_vehicle"
              action="action_vehicle_model" sequence="4"/>

</odoo>
