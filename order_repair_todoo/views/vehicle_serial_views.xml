<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View vehicle.serial View Tree -->
    <record id="view_vehicle_serial_tree" model="ir.ui.view">
        <field name="name">view.vehicle.serial.tree</field>
        <field name="model">vehicle.serial</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" />
                <field name="description"/>
                <field name="vehicle_model_id" />
                <field name="create_uid" />
                <field name="create_date" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <!-- View vehicle.serial form -->
    <record id="view_vehicle_serial_form" model="ir.ui.view">
        <field name="name">view.vehicle.serial.form</field>
        <field name="model">vehicle.serial</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Name..." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field
                                name="vehicle_model_id" options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View vehicle.serial search -->
    <record id="view_vehicle_serial_search" model="ir.ui.view">
        <field name="name">view.vehicle.serial.search</field>
        <field name="model">vehicle.serial</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="vehicle_model_id" />
                <group expand="1" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action vehicle.serial -->
    <record id="action_vehicle_serial" model="ir.actions.act_window">
        <field name="name">Serial</field>
        <field name="res_model">vehicle.serial</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Vehicle Serial.
            </p>
        </field>
    </record>

    <menuitem id="menu_repair_order_vehicle_serial" name="Vehicle Serial" parent="menu_setting_vehicle"
              action="action_vehicle_serial" sequence="5"/>

</odoo>
