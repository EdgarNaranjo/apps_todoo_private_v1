<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_repair_config_inherit_settings_form" model="ir.ui.view">
        <field name="name">repair.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Repair Settings" string="Repair Settings" data-key="repair_settings" groups="base.group_system">
                    <div id="repair">
                        <h2>Default Values</h2>
                        <div class='row mt16 o_settings_container' name="repair_setting_container">
                            <div class='col-xs-12 col-md-6 o_setting_box'>
                                <div class='o_setting_right_pane'>
                                    <span class="o_form_label">Repair type</span>
                                    <div class="text-muted">
                                        Choose the repair type as the default in your Repair.
                                    </div>
                                    <field name="repair_type_id" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class='row mt16 o_settings_container' name="repair_reason_container">
                            <div class='col-xs-12 col-md-6 o_setting_box'>
                                <div class='o_setting_right_pane'>
                                    <span class="o_form_label">Repair reason</span>
                                    <div class="text-muted">
                                        Choose the repair reason as the default in your Repair.
                                    </div>
                                    <field name="reason_id" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class='row mt16 o_settings_container' name="repair_reason_container">
                            <div class='col-xs-12 col-md-6 o_setting_box'>
                                <div class='o_setting_right_pane'>
                                    <span class="o_form_label">Invoice method</span>
                                    <div class="text-muted">
                                        Choose the invoice method for the default.
                                    </div>
                                    <field name="invoice_method"/>
                                </div>
                            </div>
                        </div>
                        <div class='row mt16 o_settings_container' name="location_container">
                            <div class='col-xs-12 col-md-6 o_setting_box'>
                                <div class='o_setting_right_pane'>
                                    <span class="o_form_label">Location</span>
                                    <div class="text-muted">
                                        Choose the location for the default.
                                    </div>
                                    <field name="location_id"/>
                                </div>
                            </div>
                        </div>
                        <div class='row mt16 o_settings_container' name="mobile_invite_email">
                            <div class='col-xs-12 col-md-6 o_setting_box'>
                                <div class='o_setting_right_pane'>
                                    <span class="o_form_label">Request demo</span>
                                    <div class="text-muted">
                                        Check the following option if you want to request to connect with the mobile app.
                                    </div>
                                    <field name="check_demo"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_setting_act_inherit_window" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'repair_settings'}</field>
    </record>

    <menuitem id="repair_config_menu" name="Settings" parent="repair.repair_menu_config" sequence="0"
              action="res_config_setting_act_inherit_window"/>


</odoo>