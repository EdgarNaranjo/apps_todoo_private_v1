<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="inherit_report_repairorder_custom" inherit_id="repair.report_repairorder">
        <xpath expr="//div[@id='informations']" position="after">
            <div id="custom_info" class="row mt32 mb32">
                <div t-if="o.vehicle_brand_id" class="col-3 bm-2">
                    <strong>Brand:</strong>
                    <p t-field="o.vehicle_brand_id.name" class="m-0"/>
                </div>
                <div t-if="o.vehicle_model_id" class="col-3 bm-2">
                    <strong>Model:</strong>
                    <p t-field="o.vehicle_model_id.name" class="m-0"/>
                </div>
                <div t-if="o.vehicle_serial_id" class="col-3 bm-2">
                    <strong>Serial:</strong>
                    <p t-field="o.vehicle_serial_id.name" class="m-0"/>
                </div>
                <div t-if="o.license_vin" class="col-3 bm-2">
                    <strong>License:</strong>
                    <p t-field="o.license_vin" class="m-0"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>