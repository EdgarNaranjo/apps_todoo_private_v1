<odoo>
    <data>
        <!-- Botones stat en account.move para documentos intercompany -->
        <record id="view_move_form_inherit_intercompany" model="ir.ui.view">
            <field name="name">account.move.form.inherit.intercompany</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_doc_intercompany"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            type="object"
                            invisible="intercompany_count == 0"
                            help="View the intercompany documents generated from this invoice">
                        <field name="intercompany_count" widget="statinfo" string="Intercompany"/>
                    </button>
                    <button name="action_open_doc_intercompany"
                            class="oe_stat_button"
                            icon="fa-link"
                            type="object"
                            invisible="intercompany_related == 0"
                            help="View the source invoice that generated this intercompany document">
                        <field name="intercompany_related" widget="statinfo" string="Source Doc"/>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="action_setting_type_journal_accounting" model="ir.actions.act_window">
            <field name="name">Intercompany Journals</field>
            <field name="res_model">setting.type.journal</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first intercompany journal configuration!
                </p>
                <p>Configure which journals to use for intercompany transactions between your companies.</p>
            </field>
            <field name="context">{'search_default_type_intercompany': 1}</field>
        </record>

        <menuitem id="account_type_journal_accounting_elogia_menu"
                  name="Intercompany Journals"
                  action="action_setting_type_journal_accounting"
                  parent="account.account_invoicing_menu"
                  sequence="99"/>
    </data>
</odoo>
