<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Extend the sale order PDF report to show Cost and Margin
            columns. These fields are added by sale_margin to all
            sale.order.line records (including optional ones with is_optional=True).
        -->
        <template
            id="report_saleorder_optional_margin"
            inherit_id="sale.report_saleorder_document"
            name="Sale Order: Margin columns">

            <!-- Add Margin and Cost columns to the header -->
            <xpath expr="//th[@name='th_subtotal']" position="before">
                <th name="th_purchase_price" class="text-end" groups="base.group_user">Cost</th>
                <th name="th_margin" class="text-end" groups="base.group_user">Margin</th>
            </xpath>

            <!-- Add Margin and Cost cells to each product line -->
            <xpath expr="//td[@name='td_product_priceunit']" position="after">
                <td name="td_purchase_price" class="text-end text-nowrap" groups="base.group_user">
                    <span
                        t-if="not line.display_type"
                        t-field="line.purchase_price"
                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
                <td name="td_margin" class="text-end text-nowrap" groups="base.group_user">
                    <span
                        t-if="not line.display_type and line.price_subtotal != 0"
                        t-field="line.margin_percent"
                        t-options='{"widget": "percentage"}'/>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
