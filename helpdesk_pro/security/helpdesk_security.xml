<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Privilege para agrupar los grupos del Helpdesk en Settings > Users & Companies -->
        <record model="res.groups.privilege" id="res_groups_privilege_helpdesk">
            <field name="name">Helpdesk Pro</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <record id="group_helpdesk_user_own" model="res.groups">
            <field name="name">User: Personal tickets</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('helpdesk_pro.group_helpdesk_user_own'))]"/>
        </record>

        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">Helpdesk Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('helpdesk_pro.group_helpdesk_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record rules -->
        <record id="res_partner_read_portal_user" model="ir.rule">
            <field name="name">Res Partner Portal User</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
        </record>
    </data>
</odoo>
