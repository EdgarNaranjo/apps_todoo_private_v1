<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="sprint_board_project.AIModelSelectorField">
        <div class="ai-model-selector">
            <!-- Chips para proveedores con lista fija -->
            <t t-if="!isCustom and suggestions.length">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <t t-foreach="suggestions" t-as="model" t-key="model">
                        <button t-att-class="'btn btn-sm rounded-pill ai-model-chip ' + (currentValue === model ? 'ai-model-chip-active' : 'ai-model-chip-inactive')"
                                t-on-click="() => selectChip(model)">
                            <t t-esc="model"/>
                        </button>
                    </t>
                </div>
                <!-- Campo texto por si quiere escribir uno custom -->
                <input type="text"
                       class="form-control form-control-sm"
                       t-att-value="currentValue"
                       placeholder="O escribe el nombre exacto del modelo..."
                       t-on-input="onCustomInput"/>
            </t>
            <!-- Campo libre para Ollama y Custom -->
            <t t-else="">
                <t t-if="provider === 'ollama'">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <t t-foreach="suggestions" t-as="model" t-key="model">
                            <button t-att-class="'btn btn-sm rounded-pill ai-model-chip ' + (currentValue === model ? 'ai-model-chip-active' : 'ai-model-chip-inactive')"
                                    t-on-click="() => selectChip(model)">
                                <t t-esc="model"/>
                            </button>
                        </t>
                    </div>
                </t>
                <input type="text"
                       class="form-control form-control-sm"
                       t-att-value="currentValue"
                       t-att-placeholder="provider === 'ollama' ? 'O escribe el nombre del modelo local...' : 'Nombre del modelo (ej: my-model-v1)'"
                       t-on-input="onCustomInput"/>
            </t>
        </div>
    </t>
</templates>
