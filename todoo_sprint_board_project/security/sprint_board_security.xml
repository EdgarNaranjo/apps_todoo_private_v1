<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupos Sprint Board -->
        <record id="group_sprint_board_viewer" model="res.groups">
            <field name="name">Board / Viewer</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
            <field name="comment">Solo puede ver Boards a los que tiene acceso.</field>
        </record>
        <record id="group_sprint_board_editor" model="res.groups">
            <field name="name">Board / Editor</field>
            <field name="category_id" ref="base.module_category_project"/>
            <field name="implied_ids" eval="[(4, ref('todoo_sprint_board_project.group_sprint_board_viewer'))]"/>
            <field name="comment">Puede crear, editar y cerrar Boards.</field>
        </record>


    </data>
</odoo>
