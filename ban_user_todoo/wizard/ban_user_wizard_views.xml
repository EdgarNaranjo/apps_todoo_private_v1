<odoo>
    <data>
        <record id="view_ban_user_wizard" model="ir.ui.view">
            <field name="name">ban.user.wizard.form</field>
            <field name="model">ban.user.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <div name="msg_ban_user_main">
                        <field name="banned" invisible="1"/>
                        <div>
                            <p colspan="2" class="alert alert-warning info_icon" role="alert" invisible="banned">
                                <b>
                                    <u>
                                        <h3 style="font-weight:bold;color:#7d5a29">Are you sure you want to block this user? :
                                        </h3>
                                    </u>
                                    <ol>
                                        <li>
                                            This action blocks all access to the related user.
                                        </li>
                                        <li>
                                            Notifies the user about the block.
                                        </li>
                                        <li>
                                            Administrator action is required to reverse this action.
                                        </li>
                                        <li>
                                            Return to the user's account to verify the block.
                                        </li>
                                    </ol>
                                </b>
                            </p>
                            <p colspan="2" class="alert alert-info info_icon" role="alert" invisible="not banned">
                                <b>
                                    <u>
                                        <h3 style="font-weight:bold;color:#7d5a29">Are you sure you want to unblock this user?
                                        </h3>
                                    </u>
                                    <ol>
                                        <li>
                                            This action grants the user access to the platform again.
                                        </li>
                                        <li>
                                            Return to the user's account to verify that everything is working normally.
                                        </li>
                                    </ol>
                                </b>
                            </p>
                        </div>
                    </div>
                    <br/>
                    <field name="user_id" invisible="1"/>
                    <group>
                        <field name="ban_reason"/>
                    </group>
                    <footer>
                        <button name="action_ban_user" string="Apply" type="object" class="btn btn-primary"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_ban_user_wizard" model="ir.actions.act_window">
            <field name="name">Blocked/Unblocked user</field>
            <field name="res_model">ban.user.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_ban_user_wizard"/>
            <field name="target">new</field>
            <field name="context">{'default_user_id': active_id}</field>
        </record>

        <record model="ir.actions.server" id="action_open_ban_wizard">
            <field name="name">Blocked/Unblocked user</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="binding_model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">
                action = env.ref('ban_user_todoo.action_ban_user_wizard').read()[0]
            </field>
            <field name="group_ids" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>
    </data>
</odoo>

