<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Settings: bloque en sección de facturación de compras -->
        <record id="res_config_settings_view_form_inherit_purchase_stock" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.purchase.stock</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='invoicing_settings_container']" position="after">
                    <block title="New Purchase Orders" name="purchase_stock_todoo_container">
                        <setting string="New purchase order applies to"
                            help="Control which purchase orders are marked as 'new' for replenishment purposes.">
                            <field name="check_options"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

        <!-- Vista lista de PO: mostrar check_new con color -->
        <record id="view_purchase_order_tree_inherit_check_new" model="ir.ui.view">
            <field name="name">purchase.order.list.inherit.check.new</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-info">check_new == True</attribute>
                </xpath>
                <field name="name" position="after">
                    <field name="check_new" optional="hide" string="New PO"
                        decoration-info="check_new"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
