<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Vista formulario: mostrar count_lines como stat button -->
        <record id="mrp_mrp_bom_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.mrp.bom.form.view.inherit</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <!-- Mejorar widget del producto en componentes -->
                <xpath expr="//field[@name='bom_line_ids']//list//field[@name='product_id']" position="attributes">
                    <attribute name="widget">many2one</attribute>
                </xpath>
            </field>
        </record>

        <!-- Vista lista: decoración cuando no hay componentes -->
        <record id="mrp_mrp_bom_tree_view_inherit" model="ir.ui.view">
            <field name="name">mrp.mrp.bom.tree.view.inherit</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="count_lines"
                        string="Components"
                        decoration-warning="count_lines == 0"
                        decoration-muted="count_lines == 0"
                        optional="show"
                        help="Number of component lines. A BoM with 0 components is not usable."/>
                </field>
            </field>
        </record>
    </data>
</odoo>
